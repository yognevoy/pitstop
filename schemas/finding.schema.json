{
  "type": "object",
  "required": [
    "category",
    "severity",
    "agent",
    "title",
    "anchors",
    "source",
    "what",
    "problem",
    "fix",
    "if_skipped",
    "effort",
    "confidence"
  ],
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "duplication",
        "needless-abstraction",
        "missed-reuse",
        "overcomplexity",
        "correctness",
        "module-boundary",
        "scattered-behavior",
        "cyclic-dependency",
        "god-module"
      ]
    },
    "severity": { "type": "string", "enum": ["must", "should", "nice"] },
    "agent": { "type": "string" },
    "title": { "type": "string" },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "symbols"],
        "properties": {
          "file": { "type": "string" },
          "symbols": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "line", "snippet"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "number" },
          "snippet": { "type": "string" }
        }
      }
    },
    "what": { "type": "string" },
    "problem": { "type": "string" },
    "fix": { "type": "string" },
    "if_skipped": { "type": "string" },
    "effort": { "type": "string", "enum": ["S", "M", "L"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
