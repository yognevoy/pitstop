{
  "type": "object",
  "required": ["version", "level", "base", "generated_at", "files"],
  "properties": {
    "version": { "type": "number" },
    "level": { "type": "string", "enum": ["quick", "full", "deep"] },
    "base": {
      "type": "object",
      "required": ["method", "base", "since", "reason"],
      "properties": {
        "method": { "type": "string", "enum": ["last_run", "fallback"] },
        "base": { "type": ["string", "null"] },
        "since": { "type": ["string", "null"] },
        "reason": { "type": "string" }
      }
    },
    "generated_at": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "commits", "added", "deleted"],
        "properties": {
          "path": { "type": "string" },
          "commits": { "type": "number" },
          "added": { "type": "number" },
          "deleted": { "type": "number" }
        }
      }
    }
  }
}
